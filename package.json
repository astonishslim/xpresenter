{
  "name": "apresentador",
  "version": "0.1.0",
  "description": "Apresentador: letras, versículos e avisos projetados para o culto, com controle remoto pelo celular.",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage \"tests/*.test.js\"",
    "dist": "electron-builder --win nsis",
    "icons": "node scripts/build-icons.js",
    "bibles": "node scripts/fetch-bibles.js"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "lucide-static": "^1.59.0"
  },
  "author": "Alisson Smith",
  "build": {
    "appId": "br.com.livres.apresentador",
    "productName": "Apresentador",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "package.json",
      "licenses/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
